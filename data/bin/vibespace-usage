#!/usr/bin/env node
// vibespace-usage — PASSIVE subscription usage capture (statusLine hook).
//
// WHY THIS EXISTS: reading Claude.ai subscription usage by calling
// GET /api/oauth/usage with the subscription's OAuth token — on a background
// timer, decoupled from interactive sessions — is exactly the "use the OAuth
// token in another tool / automated non-human access" pattern that gets
// Max/Pro accounts flagged as bots and banned (Anthropic Consumer Terms §3.7 +
// the 2026-02-20 OAuth clarification). So VibeSpace makes ZERO such calls.
//
// Instead this runs as the session's `statusLine` command. Claude Code feeds it
// a JSON payload on STDIN that ALREADY contains `.rate_limits` (5h/7d
// used_percentage + reset), which the CLI derived from the REAL API responses
// of the session you're actually running — no extra request, and only while a
// session is genuinely active. We write that to data/usage-cache/<key>.json
// (throttled) for the server to read, then render the user's own statusline
// (transparent pass-through) or a compact default. Terminal sessions only —
// stream-json/chat mode has no statusLine, so those accounts show last-known.
'use strict';
const fs = require('fs');
const path = require('path');
const cp = require('child_process');

// B-0f13: on a remote host the script lives in ~/.vibespace/bin with no
// data/ layout — the spawn env points the cache at ~/.vibespace/usage-cache.
const CACHE_DIR = process.env.VIBESPACE_USAGE_CACHE || path.join(__dirname, '..', 'usage-cache');
const THROTTLE_MS = 8000; // write at most once/8s per account — the taskbar polls
// /api/usage at ~8s (a cheap local read, no Anthropic call), so fresher writes
// let usage reflect a just-finished turn within a few seconds.

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (d) => { input += d; });
process.stdin.on('end', () => {
  let payload = {};
  try { payload = JSON.parse(input); } catch {}
  try { writeUsage(payload); } catch {}
  try { learnModel(payload); } catch {}
  // Transparent pass-through: if the user has their own statusline, render it so
  // VibeSpace terminals look identical to their normal setup. Otherwise emit a
  // compact model + usage line (better than a blank status area).
  const orig = process.env.VIBESPACE_ORIG_STATUSLINE;
  if (orig) {
    try {
      const out = cp.execSync(orig, { input, encoding: 'utf8', timeout: 4000, stdio: ['pipe', 'pipe', 'ignore'] });
      process.stdout.write(out);
      return;
    } catch {}
  }
  process.stdout.write(defaultLine(payload));
});

function win(w) {
  if (!w || typeof w.used_percentage !== 'number') return null;
  return {
    utilization: w.used_percentage / 100,
    status: w.used_percentage >= 100 ? 'limited' : 'allowed',
    resetsAt: typeof w.resets_at === 'number' ? w.resets_at : 0,
  };
}

// WHICH ACCOUNT DOES THIS READING BELONG TO (2026-09-07 — the readings-by-slot
// root cause, statusline half). VIBESPACE_ACCOUNT_KEY is fixed at SPAWN, and a
// POOLED session's credentials get re-pointed under the running CLI (the pool's
// hot switch bumps the credential file's mtime and the CLI re-reads it). So a
// spawn-time key filed every later reading under the member the session STARTED
// on — the same defect the server-side producers had. The pool's credential
// slot IS a symlink we can read, so resolve it HERE, at the moment the reading
// is produced, by the process that produced it:
//   VIBESPACE_ACCOUNT_LINK = the per-session pool link (data/pool-links/<pool>/
//   <sid>) or the pool's default link (data/subs/<poolId>) — basename of its
//   target is the member id.
// Absent (non-pooled session), unreadable, or not a symlink ⇒ the spawn key,
// which for those sessions IS fixed for the process's lifetime.
function accountKey() {
  const link = process.env.VIBESPACE_ACCOUNT_LINK;
  if (link) {
    try {
      const t = fs.readlinkSync(link);
      const id = path.basename(t);
      if (/^sub-[\w-]+$/.test(id)) return id;
    } catch {}
  }
  return String(process.env.VIBESPACE_ACCOUNT_KEY || '__global__');
}

function writeUsage(p) {
  const rl = p && p.rate_limits;
  if (!rl) return; // absent for API-key sessions / before the first API response
  const key = accountKey().replace(/[^\w.-]/g, '_');
  const f = path.join(CACHE_DIR, key + '.json');
  // Throttle: the statusline re-renders often; one write / 25s per account is
  // plenty (usage windows move slowly) and keeps disk churn negligible.
  try { const st = fs.statSync(f); if (Date.now() - st.mtimeMs < THROTTLE_MS) return; } catch {}
  const fiveHour = win(rl.five_hour) || { utilization: 0, status: 'unknown', resetsAt: 0 };
  const sevenDay = win(rl.seven_day) || { utilization: 0, status: 'unknown', resetsAt: 0 };
  // The statusline payload has NO model-scoped buckets (five_hour/seven_day
  // only — verified vs CLI 2.1.206) — those come from the server's on-demand
  // /api/usage/refresh. PRESERVE them instead of clobbering to [] every write.
  let prev = null;
  try { prev = JSON.parse(fs.readFileSync(f, 'utf-8')); } catch {}
  const out = {
    fiveHour, sevenDay,
    scopedWeekly: (prev && Array.isArray(prev.scopedWeekly)) ? prev.scopedWeekly : [],
    ...(prev && typeof prev.scopedFetchedAt === 'number' ? { scopedFetchedAt: prev.scopedFetchedAt } : {}),
    // Org identity (orgUuid/orgName/orgEmail) is captured by the server's
    // on-demand refresh — preserve it the same way as scopedWeekly.
    ...(prev && prev.orgUuid ? { orgUuid: prev.orgUuid, orgName: prev.orgName || '', ...(prev.orgEmail ? { orgEmail: prev.orgEmail } : {}) } : {}),
    // spend (extra_usage) also comes only from the on-demand refresh — the
    // statusline never carries it. Preserve, or this write nulls it (2.70.0
    // Fable-vanishing class; B-87fe).
    ...(prev && prev.spend ? { spend: prev.spend } : {}),
    overallStatus: (fiveHour.status === 'limited' || sevenDay.status === 'limited') ? 'limited' : 'allowed',
    fetchedAt: Date.now(), source: 'passive',
  };
  try { fs.mkdirSync(CACHE_DIR, { recursive: true }); } catch {}
  const tmp = f + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(out));
  fs.renameSync(tmp, f);
}

// Passive MODEL discovery: the statusLine payload names the session's current
// model (full id + display_name). Accumulate the ones you actually run into a
// shared cache so the model dropdown learns full IDs WITHOUT a /v1/models API
// call. (Claude Code has no on-disk model cache, and stream-json doesn't emit
// the model list, so this is the only zero-call way to grow the list.)
function learnModel(p) {
  const m = p && p.model;
  const id = m && (m.id || (typeof m === 'string' ? m : null));
  if (!id || typeof id !== 'string' || !/^claude-/.test(id)) return; // only full ids
  const label = (m.display_name || id);
  const f = path.join(CACHE_DIR, '__models__.json');
  let list = [];
  try { list = JSON.parse(fs.readFileSync(f, 'utf-8')); if (!Array.isArray(list)) list = []; } catch {}
  if (list.some((x) => x && x.id === id)) return; // already known
  list.push({ id, label });
  if (list.length > 50) list = list.slice(-50);
  try { fs.mkdirSync(CACHE_DIR, { recursive: true }); } catch {}
  const tmp = f + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(list));
  fs.renameSync(tmp, f);
}

function defaultLine(p) {
  const model = (p && p.model && (p.model.display_name || p.model.id)) || '';
  const rl = (p && p.rate_limits) || {};
  const pct = (w) => (w && typeof w.used_percentage === 'number') ? Math.round(w.used_percentage) : null;
  const f = pct(rl.five_hour), s = pct(rl.seven_day);
  const parts = [model];
  if (f != null) parts.push('5h ' + f + '%');
  if (s != null) parts.push('7d ' + s + '%');
  return parts.filter(Boolean).join('  ');
}
