#!/usr/bin/env node
// vibespace-usage — PASSIVE subscription usage capture (statusLine hook).
//
// WHY THIS EXISTS: reading Claude.ai subscription usage by calling
// GET /api/oauth/usage with the subscription's OAuth token — on a background
// timer, decoupled from interactive sessions — is exactly the "use the OAuth
// token in another tool / automated non-human access" pattern that gets
// Max/Pro accounts flagged as bots and banned (Anthropic Consumer Terms §3.7 +
// the 2026-02-20 OAuth clarification). So VibeSpace makes ZERO such calls.
//
// Instead this runs as the session's `statusLine` command. Claude Code feeds it
// a JSON payload on STDIN that ALREADY contains `.rate_limits` (5h/7d
// used_percentage + reset), which the CLI derived from the REAL API responses
// of the session you're actually running — no extra request, and only while a
// session is genuinely active. We write that to data/usage-cache/<key>.json
// (throttled) for the server to read, then render the user's own statusline
// (transparent pass-through) or a compact default. Terminal sessions only —
// stream-json/chat mode has no statusLine, so those accounts show last-known.
'use strict';
const fs = require('fs');
const path = require('path');
const cp = require('child_process');

// B-0f13: on a remote host the script lives in ~/.vibespace/bin with no
// data/ layout — the spawn env points the cache at ~/.vibespace/usage-cache.
const CACHE_DIR = process.env.VIBESPACE_USAGE_CACHE || path.join(__dirname, '..', 'usage-cache');
const THROTTLE_MS = 8000; // write at most once/8s per account — the taskbar polls
// /api/usage at ~8s (a cheap local read, no Anthropic call), so fresher writes
// let usage reflect a just-finished turn within a few seconds.

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (d) => { input += d; });
process.stdin.on('end', () => {
  let payload = {};
  try { payload = JSON.parse(input); } catch {}
  try { writeUsage(payload); } catch {}
  try { learnModel(payload); } catch {}
  // Transparent pass-through: if the user has their own statusline, render it so
  // VibeSpace terminals look identical to their normal setup. Otherwise emit a
  // compact model + usage line (better than a blank status area).
  const orig = process.env.VIBESPACE_ORIG_STATUSLINE;
  if (orig) {
    try {
      const out = cp.execSync(orig, { input, encoding: 'utf8', timeout: 4000, stdio: ['pipe', 'pipe', 'ignore'] });
      process.stdout.write(out);
      return;
    } catch {}
  }
  process.stdout.write(defaultLine(payload));
});

function win(w) {
  if (!w || typeof w.used_percentage !== 'number') return null;
  return {
    utilization: w.used_percentage / 100,
    status: w.used_percentage >= 100 ? 'limited' : 'allowed',
    resetsAt: typeof w.resets_at === 'number' ? w.resets_at : 0,
  };
}

// WHICH ACCOUNT DOES THIS READING BELONG TO (2026-09-07 — the readings-by-slot
// root cause, statusline half). VIBESPACE_ACCOUNT_KEY is fixed at SPAWN, and a
// POOLED session's credentials get re-pointed under the running CLI (the pool's
// hot switch bumps the credential file's mtime and the CLI re-reads it). So a
// spawn-time key filed every later reading under the member the session STARTED
// on — the same defect the server-side producers had. The pool's credential
// slot IS a symlink we can read, so resolve it HERE, at the moment the reading
// is produced, by the process that produced it:
//   VIBESPACE_ACCOUNT_LINK = the per-session pool link (data/pool-links/<pool>/
//   <sid>) or the pool's default link (data/subs/<poolId>) — basename of its
//   target is the member id.
// Absent (non-pooled session), unreadable, or not a symlink ⇒ the spawn key,
// which for those sessions IS fixed for the process's lifetime.
function accountKey() {
  const link = process.env.VIBESPACE_ACCOUNT_LINK;
  if (link) {
    try {
      const t = fs.readlinkSync(link);
      const id = path.basename(t);
      if (/^sub-[\w-]+$/.test(id)) return id;
    } catch {}
  }
  return String(process.env.VIBESPACE_ACCOUNT_KEY || '__global__');
}

// THE READING IS ONE REQUEST OLDER THAN THE LINK (2026-09-07 r3, reproduced;
// generalised 2026-09-08 by inc-mts8a8mr-ulmm).
//
// `accountKey()` resolves the credential slot at WRITE time, but `rate_limits`
// is the CLI's LAST API RESPONSE — made with the credentials the link pointed
// at BEFORE a re-point. So the first statusline render after a pool switch
// filed the old member's numbers under the new one, stamped `fetchedAt: now`,
// and `sweepUsageAnchors` (any usage-cache write is ground truth) turned that
// into an anchor for an account that had produced none of it — the B-b3cd
// odometer-flap class, on the write path.
//
// r3 answered it with the only evidence it had — the NUMBERS: while the link
// has moved but the payload still carries readings we already saw under the
// previous target, they are that target's. That clause is intact below, but it
// is now the LAST rung of ONE rule shared with the server, because the payload
// carries better evidence about itself: the WINDOW its numbers are counted in.
// A weekly reset phase is an account fingerprint (measured across this
// instance's whole anchor corpus), so a payload whose window is the previous
// slot's is the previous slot's EVEN WHEN THE NUMBERS MOVED — which is exactly
// the shape r3 could not see, and exactly the shape that cost two false pool
// switches in 98 seconds on 2026-09-08.
//
// ONE RULE, TWO SPELLINGS. This file ships as a SINGLE FILE to checkout-less
// hosts (~/.vibespace/bin) and cannot require src/, so the block below is a
// VERBATIM mirror of src/reading-lag.js between its own sentinels — pinned
// byte-for-byte AND functionally by scripts/test-readings-attribution.mjs §13.
// Editing one spelling without the other is what that pin exists to catch.
//
// State lives beside the cache as `.slot-<id>` (no `.json`, so every
// usage-cache scanner keeps ignoring it) and only for POOLED sessions — a
// session with no link cannot switch under itself, so it pays nothing.
const SLOT_STATE_MAX = 200;
/** "the numbers", the r3 evidence: utilizations AND resets, both windows. */
function rlFingerprint(rl) {
  const w = (x) => (x && typeof x === 'object') ? `${x.used_percentage}/${x.resets_at}` : '-';
  return `${w(rl.five_hour)}|${w(rl.seven_day)}`;
}
/** The account's ESTABLISHED window, as the server stamps it: only the panel
 *  refresh (`claude -p /usage`, whose key and credential dir are one decision)
 *  writes it. Absent ⇒ no established window ⇒ no evidence, and the rule falls
 *  through to the r3 fingerprint clause exactly as before.
 *
 *  IT IS READ FROM THE SIDECAR, NOT FROM THE CACHE (r2, reproduced). This file
 *  REBUILDS the cache object on every write — the `out` literal below preserves
 *  scopedWeekly / the org identity / spend one field at a time, and the window
 *  was simply never added to that list, so one ordinary statusline render (8 s
 *  cadence, our OWN write, entirely legitimate) deleted every established
 *  window on the instance and disarmed the guard end to end. The fix is not a
 *  fifth entry in a hand-written preserve list: the window moved OUT of the
 *  object every reading producer rewrites (see `windowSidecarName`). */
function ownWindowOf(key) {
  try {
    const w = JSON.parse(fs.readFileSync(path.join(CACHE_DIR, windowSidecarName(key)), 'utf-8'));
    return (w && (w.sevenDay || w.fiveHour || (w.scoped && Object.keys(w.scoped).length))) ? w : null;
  } catch { return null; }
}
/** Every account's established window, keyed off the CACHE FILES exactly as the
 *  server's `establishedWindows()` is — so a sidecar left behind by a REMOVED
 *  account is invisible here too and can never become a re-file target. */
function establishedWindows() {
  const out = {};
  let files = [];
  try { files = fs.readdirSync(CACHE_DIR).filter((f) => f.endsWith('.json') && !f.startsWith('__models__')); } catch { return out; }
  for (const fn of files) {
    const k = fn.slice(0, -5);
    const w = ownWindowOf(k);
    if (w) out[k] = w;
  }
  return out;
}
/** WHEN DID THE LINK ACTUALLY MOVE. The bound inside `decideLagShadow` is about
 *  the RE-POINT, and the pool's re-point MINTS a new symlink
 *  (`repointPoolSymlink`: symlink-to-temp + rename), so the link's OWN lstat
 *  mtime IS that instant — measured: an untouched link reads 7200 s old and
 *  0.001 s the moment after a re-point.
 *
 *  IT IS NOT `st.at` (reproduced). That is when this conversation was last SEEN
 *  under the OLD slot, which is necessarily EARLIER than the re-point that ended
 *  it, so it systematically OVERSTATES the age — and overstating is the unsafe
 *  direction. One ordinary render of an IDLE pooled terminal (30 min since its
 *  last redraw, link re-pointed one second ago) therefore expired a shadow that
 *  had not started and filed the previous member's 96 % onto the low-usage one,
 *  in a shape master's unconditional r3 rule had protected. `st.at` stays in the
 *  state file as FORENSICS; it was never evidence about a re-point.
 *
 *  Unreadable, or dated in the future (a clock anomaly, not a measurement) ⇒
 *  null ⇒ UNKNOWN, and unknown must not expire. That deliberately swallows the
 *  sub-millisecond negative a JUST-minted link can read (float noise between two
 *  clock reads — observed here as -0.00 s), where `unknown` and `just now` have
 *  the same answer anyway, rather than inventing a threshold nothing measured. */
function repointAgeMs() {
  try {
    const ms = Date.now() - fs.lstatSync(process.env.VIBESPACE_ACCOUNT_LINK).mtimeMs;
    return ms >= 0 ? ms : null;
  } catch { return null; }
}
/** A refusal is an assertion about the system, so it is written down. Beside the
 *  cache (a checkout-less host cannot derive the server's archive path) and NOT
 *  ending in `.json`, so every usage-cache scanner keeps ignoring it. Bounded by
 *  appending the head to a per-DAY shard, never by truncating it away.
 *
 *  IT IS A SAMPLE, NOT A COUNT, and it says so on every line. A statusline is a
 *  fresh process per render, so it cannot hold the engine's per-session/per-
 *  verdict memory; a genuinely persistent mismatch would otherwise write ~11 500
 *  lines a day at the 8 s cadence. One line per 60 s (the file's own mtime is
 *  the clock) keeps the fact and drops the repetition — the rate floor is
 *  instance-wide, so a second account refusing inside the same minute is
 *  represented by the line already there rather than by one of its own. */
const REFUSAL_FLOOR_MS = 60000;
function noteWindowRefusal(key, d) {
  try {
    fs.mkdirSync(CACHE_DIR, { recursive: true });
    const f = path.join(CACHE_DIR, '.window-refused.ndjson');
    try { const st = fs.statSync(f); if (st.size && Date.now() - st.mtimeMs < REFUSAL_FLOOR_MS) return; } catch { }
    try {
      if (fs.statSync(f).size > 256 * 1024) {
        const day = new Date().toISOString().slice(0, 10).replace(/-/g, '');
        fs.appendFileSync(f.replace(/\.ndjson$/, `-${day}.ndjson`), fs.readFileSync(f));
        fs.writeFileSync(f, '');
      }
    } catch { }
    fs.appendFileSync(f, JSON.stringify({ at: Date.now(), by: 'statusline', sampled: '<=1/60s', key, action: d.action, to: d.key, reason: d.reason, matched: d.matched }) + '\n');
  } catch { }
}

// >>> reading-lag mirror (src/reading-lag.js) — keep byte-identical
const WEEK_SEC = 604800;      // a weekly window's period; a roll is exactly this
const JITTER_SEC = 120;       // the panel and the event stream spell one window ±60 s apart
const SHADOW_MS = 10 * 60e3;  // a re-point stops explaining anything after this

/** A weekly window's ACCOUNT-STABLE half: which instant of the week it resets
 *  at. A roll adds exactly WEEK_SEC, so this does not move. */
function weeklyPhase(resetsAt) {
  const n = Number(resetsAt);
  if (!Number.isFinite(n) || n <= 0) return null;
  return ((n % WEEK_SEC) + WEEK_SEC) % WEEK_SEC;
}
/** Circular distance on the week, so 1 s past the boundary is not half a week
 *  away from 1 s before it. */
function weeklyNear(a, b, jitterSec = JITTER_SEC) {
  const p = weeklyPhase(a), q = weeklyPhase(b);
  if (p == null || q == null) return null;
  const d = Math.abs(p - q) % WEEK_SEC;
  return Math.min(d, WEEK_SEC - d) <= jitterSec;
}
/** WHERE THE ESTABLISHED WINDOW LIVES (r2). NOT inside the usage-cache
 *  snapshot: that object is REBUILT WHOLESALE by every reading producer — the
 *  statusline hook (once per 8 s per account), the on-demand ⟳, the codex
 *  snapshot writer — so a field there survives only while every one of them
 *  remembers to carry it forward. This exact file has already lost
 *  `scopedWeekly`, the org identity, `spend` and `corroborated` that way, and
 *  `ownWindow` was the fifth: ONE ordinary statusline render deleted the only
 *  evidence the guard below runs on, and the incident replayed end to end.
 *  So the window a member's buckets are counted in lives BESIDE the cache, in
 *  a file no reading producer writes at all: `.window-<key>` — no `.json`, so
 *  every usage-cache scanner keeps ignoring it, exactly as the `.slot-<id>`
 *  sidecar next to it already relies on. A fact only one producer may state
 *  does not belong in the object all the others rewrite. */
function windowSidecarName(key) { return '.window-' + String(key).replace(/[^\w.-]/g, '_'); }

/** The window fingerprint of ANY of the shapes this codebase carries readings
 *  in — a usage-cache snapshot, an anchor's `buckets`, the statusline's
 *  `rate_limits`, or one parsed rate_limit_event (which names ONE bucket).
 *  Returns {sevenDay, fiveHour, scoped:{name:resetsAt}}; absent = null, never
 *  0, because "no window stated" and "a window at the epoch" are different
 *  facts and only one of them is evidence. */
function windowOf(x) {
  const out = { sevenDay: null, fiveHour: null, scoped: {} };
  if (!x || typeof x !== 'object') return out;
  const pos = (v) => { const n = Number(v); return Number.isFinite(n) && n > 0 ? n : null; };
  // one parsed rate_limit_event: {kind:'sevenDay'|'fiveHour'|'scoped', scopedName, resetsAt}
  if (typeof x.kind === 'string' && ('resetsAt' in x) && !x.sevenDay && !x.fiveHour && !x.seven_day) {
    const r = pos(x.resetsAt);
    if (x.kind === 'sevenDay') out.sevenDay = r;
    else if (x.kind === 'fiveHour') out.fiveHour = r;
    else if (x.kind === 'scoped' && x.scopedName && r) out.scoped[String(x.scopedName).toLowerCase()] = r;
    return out;
  }
  // AN EMPTY WINDOW IS NOT IDENTITY EVIDENCE (B-8b12). A window that has not
  // started answers `resetsAt = now + windowDuration` on every read — measured
  // on this instance, 144 distinct values over 149 consecutive reads of one
  // bucket. Its "phase" is therefore a reading of OUR clock, not of the
  // account, and feeding it to `compareWindows` produces a fresh disagreement
  // every few seconds against a member's own established window. The producers
  // stamp `state` on the bucket (the derived usage-cache view does it for
  // every writer at once); an unstamped bucket is pre-model data and counts,
  // which is the conservative direction — this rule may only ever REMOVE
  // evidence, never invent it.
  const counts = (b) => !b || typeof b !== 'object' || b.state === undefined || b.state === 'running';
  const b7 = x.sevenDay || x.seven_day;
  const b5 = x.fiveHour || x.five_hour;
  if (counts(b7)) out.sevenDay = pos(b7 && typeof b7 === 'object' ? (b7.resetsAt ?? b7.resets_at) : b7);
  if (counts(b5)) out.fiveHour = pos(b5 && typeof b5 === 'object' ? (b5.resetsAt ?? b5.resets_at) : b5);
  const sw = Array.isArray(x.scopedWeekly) ? x.scopedWeekly : [];
  for (const s of sw) {
    if (!s || !s.name || !counts(s)) continue;
    const r = pos(s.resetsAt ?? s.resets_at);
    if (r) out.scoped[String(s.name).toLowerCase()] = r;
  }
  return out;
}

/** A stable string for "are these the same numbers" (the r3 clause). Windows
 *  only — utilizations belong to `readingFingerprint` callers that have them. */
function windowFingerprint(win) {
  const w = win && win.scoped ? win : windowOf(win);
  const sc = Object.keys(w.scoped).sort().map((k) => `${k}=${w.scoped[k]}`).join(',');
  return `7d:${w.sevenDay || '-'}|5h:${w.fiveHour || '-'}|sc:${sc}`;
}

/** Does a reading's window say it came from `memberWindow`'s credentials?
 *  'agree' | 'differ' | 'unknown' — three states, because "we cannot tell" must
 *  never be spelled the same way as "yes".
 *
 *  THE WEEKLY HALF IS THE ONLY IDENTITY EVIDENCE (r2, measured — the first
 *  spelling of this rule also asked the 5-hour window, and that was wrong in
 *  both directions). A weekly reset is an account property: every identity in
 *  this instance's 30-day corpus has exactly ONE weekly phase, stable across
 *  the period, and all seven are distinct. A FIVE-HOUR reset is a property of
 *  a TIME: it opens at the account's first request in the block and then snaps
 *  to the clock, so on the same corpus
 *    · a SAME-account 5h reading sits >120 s from that account's own
 *      still-future stamped 5h on 7.2 % (33/456) and 7.4 % (47/639) of the two
 *      busiest streams — a 'differ' about its rightful owner; and
 *    · DIFFERENT identities carry IDENTICAL 5h resets constantly (47 distinct
 *      colliding values; `resetsAt mod 1800` piles onto :00/:10/:29/:30) — an
 *      'agree' with a stranger.
 *  Scanned end to end, that rung would have re-filed a legitimate reading onto
 *  another account at 50 real moments. So five-hour is recorded (it is useful
 *  in a fingerprint, and forensics want it) and never asked WHO. A reading
 *  with no weekly component answers 'unknown', and the callers below treat
 *  that as no evidence — which is the honest answer, not a cheap one.
 *
 *  Note there is no `nowSec`: comparing weekly PHASES (mod one week) survives
 *  a roll by construction, so identity is decided without consulting a clock.
 *  The 5-hour rung was the only thing that ever needed the time. */
function compareWindows(readingWin, memberWin, { jitterSec = JITTER_SEC } = {}) {
  const a = readingWin && readingWin.scoped ? readingWin : windowOf(readingWin);
  const b = memberWin && memberWin.scoped ? memberWin : windowOf(memberWin);
  let weekly = null;
  const wk = weeklyNear(a.sevenDay, b.sevenDay, jitterSec);
  if (wk !== null) weekly = wk;
  for (const name of Object.keys(a.scoped)) {
    const r = weeklyNear(a.scoped[name], b.scoped[name], jitterSec);
    if (r === null) continue;
    if (r === false) weekly = false;         // one disagreeing scoped bucket is a disagreement
    else if (weekly === null) weekly = true;
  }
  if (weekly === true) return 'agree';
  if (weekly === false) return 'differ';
  return 'unknown';
}

/** ① THE LAG SHADOW. A reading that arrives after the link moved was produced
 *  by whichever credentials the request carried, and a re-point reaches the CLI
 *  on its NEXT request — never the response already in flight.
 *
 *  Evidence order, strongest first:
 *    · the window matches the slot we LEFT and not the one we moved to ⇒ the
 *      previous slot (the 05:27 incident, verbatim);
 *    · the window matches the one we moved to and not the one we left ⇒ the new
 *      slot (the shadow is over — this is what ends it);
 *    · BOUNDED: with the windows silent, a re-point older than `shadowMs`
 *      explains nothing, so a session that never speaks again can never pin a
 *      slot forever;
 *    · neither window decidable (unknown windows, or two members that genuinely
 *      share a weekly phase) ⇒ the r3 statusline clause: numbers identical to
 *      the last ones seen under the previous slot are still those numbers.
 *
 *  THE CLOCK RANKS BELOW THE WINDOWS (r3, reproduced). The bound used to
 *  short-circuit FIRST, above every window rung, and that made the whole rule
 *  only as good as its caller's estimate of the age. The shipped statusline has
 *  no re-point instant in hand and passed the age of its last OBSERVATION
 *  instead, so ONE ordinary render of an idle pooled TERMINAL session — 30 min
 *  since its last redraw, link re-pointed one second ago — answered
 *  `shadow-expired` and filed the previous member's 96 % onto the low-usage
 *  one, replaying the incident including its second false switch, and doing it
 *  in a shape MASTER's unconditional r3 rule had protected.
 *
 *  A clock is a PROXY for "were those credentials still in play"; the window is
 *  the ANSWER. A proxy may never overrule the thing it stands in for, so the
 *  bound now applies only where there is nothing else to go on — which is also
 *  the only place it was ever load-bearing. And `repointAgeMs == null` is
 *  UNKNOWN and does NOT expire: a caller that cannot date the re-point has not
 *  thereby proved the shadow is over (spelling unknown like 'expired' is how
 *  the r3 protection was deleted in the first place). */
function decideLagShadow({
  prevKey = null, prevWindow = null, newKey = null, newWindow = null,
  readingWindow = null, readingFingerprint = null, prevFingerprint = null,
  repointAgeMs = 0, shadowMs = SHADOW_MS, jitterSec = JITTER_SEC,
} = {}) {
  if (!prevKey || !newKey || prevKey === newKey) return { key: newKey, shadowed: false, why: 'no-repoint' };
  const cmpPrev = prevWindow ? compareWindows(readingWindow, prevWindow, { jitterSec }) : 'unknown';
  const cmpNew = newWindow ? compareWindows(readingWindow, newWindow, { jitterSec }) : 'unknown';
  if (cmpPrev === 'agree' && cmpNew === 'differ') return { key: prevKey, shadowed: true, why: 'window-of-previous-slot', cmpPrev, cmpNew };
  if (cmpNew === 'agree' && cmpPrev === 'differ') return { key: newKey, shadowed: false, why: 'window-of-new-slot', cmpPrev, cmpNew };
  if (repointAgeMs != null && (!(Number(repointAgeMs) >= 0) || Number(repointAgeMs) > shadowMs)) return { key: newKey, shadowed: false, why: 'shadow-expired', cmpPrev, cmpNew };
  if (readingFingerprint && prevFingerprint && readingFingerprint === prevFingerprint) {
    return { key: prevKey, shadowed: true, why: 'identical-payload', cmpPrev, cmpNew };
  }
  return { key: newKey, shadowed: false, why: 'no-evidence', cmpPrev, cmpNew };
}

/** ② THE WINDOW IDENTITY GUARD. Whatever bookkeeping named `key`, a reading
 *  whose window contradicts that member's OWN established window is not that
 *  member's. `windows` is {accountId: window}; `groupOf` collapses the identity
 *  groups an org-merged login spans (`__global__` + the named sub are ONE
 *  account, and must not read as two matches).
 *
 *  Outcomes — every one of them NAMED, none of them silent:
 *    write   — agrees, or there is no evidence either way (the honest default:
 *              a guard with no evidence must not delete data)
 *    refile  — contradicts the target and matches EXACTLY ONE other account
 *    archive — contradicts the target and matches none, or several */
function decideReadingTarget({ key, readingWindow, windows = {}, groupOf = null, jitterSec = JITTER_SEC } = {}) {
  const win = readingWindow && readingWindow.scoped ? readingWindow : windowOf(readingWindow);
  // NO WEEKLY COMPONENT = NO IDENTITY EVIDENCE. A `five_hour` rate_limit_event
  // states a window, but a 5-hour window names a TIME, not an account (see
  // `compareWindows`), so such a reading can never be moved or refused. Stated
  // here at the decision point so the REASON that reaches the journal and the
  // archive is true: `compareWindows` already answers 'unknown' for it, but
  // "no established window to contradict" would be a false sentence about a
  // target that has one — and in this subsystem the reason IS the diagnosis.
  if (!win.sevenDay && !Object.keys(win.scoped).length) {
    return { action: 'write', key, reason: 'reading states no weekly window', matched: [] };
  }
  const own = windows[key] || null;
  const mine = own ? compareWindows(win, own, { jitterSec }) : 'unknown';
  if (mine !== 'differ') {
    return { action: 'write', key, reason: mine === 'agree' ? 'window matches the target' : 'no established window to contradict', matched: [] };
  }
  const grp = (id) => (groupOf ? groupOf(id) : id) || id;
  const hits = new Map(); // group → representative id
  for (const id of Object.keys(windows)) {
    if (id === key) continue;
    if (compareWindows(win, windows[id], { jitterSec }) !== 'agree') continue;
    const g = grp(id);
    if (!hits.has(g)) hits.set(g, id);
  }
  const matched = [...hits.values()];
  if (matched.length === 1) {
    return { action: 'refile', key: matched[0], reason: `window ${windowFingerprint(win)} is not ${key}'s (${windowFingerprint(own)}) and matches exactly one account`, matched };
  }
  return {
    action: 'archive', key: null, matched,
    reason: matched.length
      ? `window ${windowFingerprint(win)} is not ${key}'s (${windowFingerprint(own)}) and matches ${matched.length} accounts — no single owner can be proven`
      : `window ${windowFingerprint(win)} is not ${key}'s (${windowFingerprint(own)}) and matches no known account`,
  };
}
// <<< reading-lag mirror
function slotStateFile(p) {
  const id = String((p && p.session_id) || path.basename(process.env.VIBESPACE_ACCOUNT_LINK || '')).replace(/[^\w.-]/g, '_');
  return id ? path.join(CACHE_DIR, '.slot-' + id.slice(0, 80)) : null;
}
function readSlotState(f) { try { return JSON.parse(fs.readFileSync(f, 'utf-8')); } catch { return null; } }
function writeSlotState(f, st, fresh) {
  try {
    fs.mkdirSync(CACHE_DIR, { recursive: true });
    // Bound the directory ONCE per conversation (only when creating a new
    // state file) — a readdir on every statusline render would be a cost with
    // no purpose.
    if (fresh) {
      const all = fs.readdirSync(CACHE_DIR).filter((n) => n.startsWith('.slot-'));
      if (all.length > SLOT_STATE_MAX) {
        const byAge = all.map((n) => ({ n, t: (() => { try { return fs.statSync(path.join(CACHE_DIR, n)).mtimeMs; } catch { return 0; } })() })).sort((a, b) => a.t - b.t);
        for (const e of byAge.slice(0, all.length - SLOT_STATE_MAX)) { try { fs.unlinkSync(path.join(CACHE_DIR, e.n)); } catch {} }
      }
    }
    fs.writeFileSync(f + '.tmp', JSON.stringify(st));
    fs.renameSync(f + '.tmp', f);
  } catch {}
}

function writeUsage(p) {
  const rl = p && p.rate_limits;
  if (!rl) return; // absent for API-key sessions / before the first API response
  let key = accountKey().replace(/[^\w.-]/g, '_');
  if (process.env.VIBESPACE_ACCOUNT_LINK) {
    const sf = slotStateFile(p);
    if (sf) {
      const fp = rlFingerprint(rl);
      const win = windowOf(rl);
      const st = readSlotState(sf);
      // The state is updated on every OBSERVATION, not only on every write:
      // the throttle below skips most renders, and a payload seen (but not
      // written) under the old target is still evidence about which
      // credentials produced the numbers we are looking at now.
      if (st && st.key && st.key !== key) {
        const d = decideLagShadow({
          prevKey: st.key, prevWindow: ownWindowOf(st.key) || st.win || null,
          newKey: key, newWindow: ownWindowOf(key),
          readingWindow: win, readingFingerprint: fp, prevFingerprint: st.fp || null,
          // the RE-POINT instant, read off the link the pool re-minted (see
          // repointAgeMs) — never `st.at`, which dates our last OBSERVATION and
          // is systematically older; unreadable ⇒ null ⇒ unknown ⇒ never expires.
          repointAgeMs: repointAgeMs(),
        });
        if (d.shadowed) {
          writeSlotState(sf, { key: st.key, fp, win, at: Number(st.at) || Date.now() }, false);
          return; // these numbers are the PREVIOUS slot's — leave them there
        }
      }
      writeSlotState(sf, { key, fp, win, at: Date.now() }, !st);
    }
  }
  // ② THE WINDOW IDENTITY GUARD — the same rule the server applies to every
  //    value producer, now applied by the producer that had NONE: this hook is
  //    the highest-frequency writer on the instance (once per 8 s per account)
  //    and every path that reaches this line without a shadow (a session with
  //    no link, an unreadable link, a re-point past the horizon, a payload the
  //    windows could not place) used to write whatever `accountKey()` resolved.
  //    A reading whose weekly window contradicts the target's own established
  //    window is not that target's, so it is re-filed on the one account whose
  //    window matches, else refused — the numbers stay where they were and the
  //    refusal is written down. NO EVIDENCE ⇒ NO REFUSAL is the shared rule's,
  //    so an instance with no established windows behaves exactly as before.
  //
  //    THE ONE THING A SINGLE SHIPPED FILE CANNOT DO: it has no identity-group
  //    table, so an org-merged login ('__global__' + its named sub) reads as TWO
  //    matches and its reading is REFUSED rather than re-filed. That is the
  //    conservative direction — nothing is written anywhere — and the server's
  //    own guard, which HAS the table, still sees every later reading.
  //
  //    It runs AFTER the slot state has been written, and it deliberately does
  //    not touch it: that state records which credential SLOT this conversation
  //    resolved to, which is what the shadow reasons about next time. Where the
  //    NUMBERS ended up is a different question, and answering it here would
  //    make the next render believe the link had moved when it had not.
  //    Cost, measured on this instance's usage-cache: one readdir of 13 entries
  //    plus ≤7 sidecar reads totalling 8590 bytes for the whole directory.
  {
    const d = decideReadingTarget({ key, readingWindow: windowOf(rl), windows: establishedWindows() });
    if (d.action !== 'write') noteWindowRefusal(key, d);
    if (d.action === 'archive') return;
    if (d.action === 'refile') key = d.key;
  }
  const f = path.join(CACHE_DIR, key + '.json');
  // Throttle: the statusline re-renders often; one write / 25s per account is
  // plenty (usage windows move slowly) and keeps disk churn negligible.
  try { const st = fs.statSync(f); if (Date.now() - st.mtimeMs < THROTTLE_MS) return; } catch {}
  const fiveHour = win(rl.five_hour) || { utilization: 0, status: 'unknown', resetsAt: 0 };
  const sevenDay = win(rl.seven_day) || { utilization: 0, status: 'unknown', resetsAt: 0 };
  let prev = null;
  try { prev = JSON.parse(fs.readFileSync(f, 'utf-8')); } catch {}
  // STATE WHAT YOU MEASURED; KEEP EVERYTHING ELSE BY CONSTRUCTION (r2).
  //
  // This used to be an object literal that ENUMERATED the fields worth
  // preserving, and that list is the single most expensive line of code in this
  // store's history: it has silently deleted `scopedWeekly` (2.70.0, the Fable
  // cap vanishing), the org identity, `spend` (B-87fe), `corroborated`, the
  // established window — which is why THAT fact was moved to a sidecar no
  // producer rewrites (2.369.73 r2) — and, measured against the real tool over
  // a migrated real cache file, `limits`: the typed half of every claude
  // snapshot, three limits in and zero out, the overage limit gone entirely,
  // and the next reader re-deriving them under THIS producer's name and clock.
  //
  // Six losses, one mechanism: a list of what to KEEP is a promise every future
  // edit has to remember. A spread of what was there is a property. So `prev`
  // goes in first and only the fields this render actually measured are stated
  // after it.
  const out = {
    ...(prev && typeof prev === 'object' ? prev : {}),
    fiveHour, sevenDay,
    // the statusline payload has NO model-scoped buckets (five_hour/seven_day
    // only — verified vs CLI 2.1.206); they come from the server's on-demand
    // refresh, and an account that has never had one still needs the field
    // present (it is how a reader tells a claude snapshot from a codex one)
    scopedWeekly: (prev && Array.isArray(prev.scopedWeekly)) ? prev.scopedWeekly : [],
    overallStatus: (fiveHour.status === 'limited' || sevenDay.status === 'limited') ? 'limited' : 'allowed',
    fetchedAt: Date.now(), source: 'passive',
  };
  // THE ONE LIMIT THIS PRODUCER KNOWS ABOUT IS THE ONE IT DROPS. `limits` is
  // the canonical half (src/usage-cache-write.js) and every entry carries its
  // own source and its own age. This tool can measure exactly one of them — the
  // plan limit — and it has just written that reading into the legacy buckets
  // above, where `liftCacheObject` reconstructs it stamped with this object's
  // own `source`/`fetchedAt`. Dropping it is therefore the whole update: every
  // OTHER limit (a model-scoped cap, the overage limit) survives byte-identical
  // with the provenance of the producer that DID measure it, and this file —
  // which cannot require src/ and must not carry a second spelling of the
  // model's window rules — never has to construct a limit at all.
  if (Array.isArray(out.limits)) out.limits = out.limits.filter((l) => !l || l.limitId !== 'plan');
  // …and one field is deliberately NOT inherited: `corroborated` is a verdict
  // about ONE reading (did the OTel observation agree with the credential slot
  // that reading was filed on), and this is a different reading, taken by a
  // producer that has no observation to compare against. Carrying it forward
  // would attach somebody else's corroboration to these numbers — the spread
  // preserves what it does not know about, not what it knows it cannot claim.
  delete out.corroborated;
  try { fs.mkdirSync(CACHE_DIR, { recursive: true }); } catch {}
  const tmp = f + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(out));
  fs.renameSync(tmp, f);
}

// Passive MODEL discovery: the statusLine payload names the session's current
// model (full id + display_name). Accumulate the ones you actually run into a
// shared cache so the model dropdown learns full IDs WITHOUT a /v1/models API
// call. (Claude Code has no on-disk model cache, and stream-json doesn't emit
// the model list, so this is the only zero-call way to grow the list.)
function learnModel(p) {
  const m = p && p.model;
  const id = m && (m.id || (typeof m === 'string' ? m : null));
  if (!id || typeof id !== 'string' || !/^claude-/.test(id)) return; // only full ids
  const label = (m.display_name || id);
  const f = path.join(CACHE_DIR, '__models__.json');
  let list = [];
  try { list = JSON.parse(fs.readFileSync(f, 'utf-8')); if (!Array.isArray(list)) list = []; } catch {}
  if (list.some((x) => x && x.id === id)) return; // already known
  list.push({ id, label });
  if (list.length > 50) list = list.slice(-50);
  try { fs.mkdirSync(CACHE_DIR, { recursive: true }); } catch {}
  const tmp = f + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(list));
  fs.renameSync(tmp, f);
}

function defaultLine(p) {
  const model = (p && p.model && (p.model.display_name || p.model.id)) || '';
  const rl = (p && p.rate_limits) || {};
  const pct = (w) => (w && typeof w.used_percentage === 'number') ? Math.round(w.used_percentage) : null;
  const f = pct(rl.five_hour), s = pct(rl.seven_day);
  const parts = [model];
  if (f != null) parts.push('5h ' + f + '%');
  if (s != null) parts.push('7d ' + s + '%');
  return parts.filter(Boolean).join('  ');
}
