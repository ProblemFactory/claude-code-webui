# ── ALL of data/ is runtime state — NEVER track — EXCEPT data/bin/ (the static
# tools the server ships). Belt-and-suspenders over the explicit list below so a
# NEW data file (e.g. data/telemetry/) can never be committed by accident. ──
data/*
!data/bin/
data/bin/code
data/bin/editor/
# generated at startup by createStatusHelper() — never track (dirties the tree, blocks git pull)
data/bin/vibespace-status
# downloaded by installRclone()/boot self-heal — a 60MB arch-specific binary must
# never live in git (2.368.9: it did since the one-click-install commit; every pin
# bump would grow public history by 60MB+, and the boot self-heal writing a tracked
# file is the dirty-tree-blocks-git-pull class). Boot reinstalls it when missing.
data/bin/rclone
data/bin/rclone-dl.zip
# heavy-tier release-gate results (scripts/ci.mjs --heavy): <sha>.{green,red,pid,log}
# — local run records, never history. Already covered by data/* above; spelled
# out because a reader looking for "where does the push-blocking marker live"
# should find it named.
data/ci-heavy/
*.nfs*
.agent-context/
data/.agent-hooks-optout
# ── Sensitive runtime state (NEVER track — key files + their ciphertext = plaintext) ──
data/auth.json
data/accounts.json
data/.accounts-key
data/subs/
data/codex-subs/
data/usage-cache/
data/usage-history/
data/codex-models-seen.json
data/mounts.json
data/.mounts-key
data/mount-tokens.json
data/mount-logs/
data/hosts.json
data/ssh/
data/remote-jsonl/
data/session-status.json
data/user-todos.json
data/task-groups.json
data/tasks.json
data/uploads-sync.json
.claude/worktrees/
data/bin/vibespace-agentd.js
data/bin/vibespace-agentd-attach.js
src/lib/build-version.js
# §8 of scripts/test-new-member-wake.mjs writes PATCHED COPIES of
# src/server/usage-pool-engine.js beside the real one (they must be SIBLINGS or
# their relative requires do not resolve). They are unlinked on exit and swept
# at start, but a SIGKILL can strand one — and a dirty tree is what the release
# gate REFUSES on, so they can never be allowed to become tree state.
src/server/vs-wake-mut-*.js
src/server/vs-wake-master-ar-*.js
src/vs-wake-mut-*.js
# §18 of scripts/test-readings-attribution.mjs writes a PATCHED COPY of
# src/server/usage-pool-engine.js beside the real one (same reason: relative
# requires). Unlinked on exit, swept by PID at start; a SIGKILL must never be
# able to dirty the tree and block the release gate.
src/server/vs-readattr-mut-*.js
# scripts/test-auto-resume.mjs §12a writes PATCHED COPIES of
# src/server/auto-resume.js beside the real one (they must be SIBLINGS or their
# relative requires do not resolve). Unlinked on exit and swept at start, but a
# SIGKILL can strand one — and a dirty tree is what the release gate REFUSES on.
src/server/vs-aredge-mut-*.js

# §5c of scripts/test-spend-paths.mjs writes PATCHED COPIES of
# src/server/conversation-deliver.js beside the real one (SIBLINGS, or their
# relative requires do not resolve). Unlinked on exit and swept by PID at
# start, but a SIGKILL can strand one — and a dirty tree is what the release
# gate REFUSES on.
src/server/vs-spend-mut-*.js
# throwaway patched copies of src/server/session-stdout.js written BESIDE the
# real module by scripts/test-restore-liveness.mjs (they must be SIBLINGS or
# their relative requires do not resolve). Unlinked on exit, but a SIGKILL can
# strand one — and a dirty tree is what the release gate REFUSES on.
src/server/session-stdout.__*_control.js
